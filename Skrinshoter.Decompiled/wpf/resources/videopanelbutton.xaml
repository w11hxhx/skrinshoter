<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Panel.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="VideoPanelButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Height" Value="{StaticResource VideoPanelSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize.PanelButton}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PanelButton.Normal.Color}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="ToolTipService.HorizontalOffset" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="{StaticResource Panel.Background}">
            <Border Name="highlight" Background="{TemplateBinding Control.Background}" CornerRadius="8" Margin="2,6">
              <Grid Margin="{TemplateBinding Control.Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="24" Height="24" Stretch="None" Source="{Binding Path=(local:IconProperties.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Name="contentPresenter" Grid.Column="1" Margin="4,-1,1,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EmphasizedVideoPanelButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource VideoPanelButtonStyle}">
    <Setter Property="Background" Value="{StaticResource PanelButton.Emphasized.Background}" />
  </Style>
</ResourceDictionary>