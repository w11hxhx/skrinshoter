<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <GeometryGroup x:Key="MessageWindowCloseButton.Geometry">
    <LineGeometry StartPoint="8,8" EndPoint="16,16" />
    <LineGeometry StartPoint="16,8" EndPoint="8,16" />
  </GeometryGroup>
  <SolidColorBrush x:Key="MessageWindowCloseButton.Normal.Color" Color="#B0FFFFFF" />
  <SolidColorBrush x:Key="MessageWindowCloseButton.MouseOver.Color" Color="White" />
  <Style x:Key="MessageWindowCloseButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="#00FFFFFF" Width="24" Height="24">
            <Path Name="CrossPath" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource MessageWindowCloseButton.Normal.Color}" Data="{StaticResource MessageWindowCloseButton.Geometry}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="CrossPath" Property="Shape.Stroke" Value="{StaticResource MessageWindowCloseButton.MouseOver.Color}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>