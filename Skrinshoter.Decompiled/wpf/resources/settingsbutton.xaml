<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SettingsButton.Static.Background" Color="#FFF5F7F9" />
  <SolidColorBrush x:Key="SettingsButton.Static.Foreground" Color="#FF000000" />
  <SolidColorBrush x:Key="SettingsButton.MouseOver.Background" Color="#FFEEF5F9" />
  <SolidColorBrush x:Key="SettingsButton.Pressed.Background" Color="#FFE1F0F8" />
  <SolidColorBrush x:Key="SettingsButton.Disabled.Background" Color="#FFF9F9FA" />
  <SolidColorBrush x:Key="SettingsButton.Disabled.Foreground" Color="#66000000" />
  <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Height" Value="35" />
    <Setter Property="MinWidth" Value="125" />
    <Setter Property="Padding" Value="18,0,19,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="border" BorderThickness="0" CornerRadius="8" SnapsToDevicePixels="true" Padding="{TemplateBinding Control.Padding}" Background="{StaticResource SettingsButton.Static.Background}">
            <ContentPresenter Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" TextElement.Foreground="{StaticResource SettingsButton.Static.Foreground}">
              <UIElement.RenderTransform>
                <TranslateTransform Y="-1" />
              </UIElement.RenderTransform>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource SettingsButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource SettingsButton.Pressed.Background}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource SettingsButton.Disabled.Background}" />
              <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{StaticResource SettingsButton.Disabled.Foreground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>