<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <Style x:Key="ToolTipIconStyle" TargetType="{x:Type ContentControl}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Grid SnapsToDevicePixels="True">
            <Image Name="PART_Icon" Width="20" Height="20" Source="{StaticResource QuestionImage}" />
            <Popup Name="PART_Popup" StaysOpen="True" AllowsTransparency="True" Placement="Right" PlacementTarget="{Binding ElementName=PART_Icon}">
              <local:Panel Style="{StaticResource PanelStyle}">
                <ContentPresenter Margin="18,12,18,16" TextElement.FontSize="15" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" TextElement.FontFamily="{StaticResource App.FontFamily}" />
              </local:Panel>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Icon" Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="PART_Popup" Property="Popup.IsOpen" Value="True" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>