<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <Geometry x:Key="SplitActionComboBoxDropDownArrowGeometry">F1 M3.96524,6 C3.77279,6.33333 3.29166,6.33333 3.09921,6 L0.0681247,0.75 C-0.124325,0.416667 0.116238,0 0.501138,0 L6.56332,0 C6.94822,0 7.18878,0.416667 6.99633,0.75 Z</Geometry>
  <Style x:Key="SplitActionComboBoxActionButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{StaticResource PanelButton.Emphasized.Background}" />
    <Setter Property="ToolTipService.HorizontalOffset" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="#00FFFFFF">
            <Border Name="highlight" Background="{TemplateBinding Control.Background}" CornerRadius="8,0,0,8" Margin="2,6,0,6">
              <Grid>
                <Image Name="icon" Width="32" Height="32" Stretch="None" Margin="2,0,-3,0" IsHitTestVisible="False" Visibility="Collapsed" Source="{Binding ButtonIcon, RelativeSource={RelativeSource AncestorType={x:Type local:SplitActionComboBox}}}" />
                <ContentPresenter Name="face" Margin="2,0,-3,0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding ButtonContent, RelativeSource={RelativeSource AncestorType={x:Type local:SplitActionComboBox}}}" ContentTemplate="{Binding ButtonContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:SplitActionComboBox}}}" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding ButtonContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:SplitActionComboBox}}}" Value="{x:Null}">
              <Setter TargetName="icon" Property="Visibility" Value="Visible" />
              <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="UIElement.Opacity" Value="0.3" />
              <Setter TargetName="face" Property="UIElement.Opacity" Value="0.3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SplitActionComboBoxArrowToggleButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ButtonBase.ClickMode" Value="Press" />
    <Setter Property="Background" Value="{StaticResource PanelButton.Emphasized.Background}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="#00FFFFFF">
            <Border Name="highlight" Background="{TemplateBinding Control.Background}" CornerRadius="0,8,8,0" Margin="0,6,2,6">
              <Path Name="arrow" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,1,7,0" Fill="{StaticResource PanelComboBox.Arrow.Normal.Color}" Data="{StaticResource SplitActionComboBoxDropDownArrowGeometry}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
              <Setter TargetName="arrow" Property="Shape.Fill" Value="{StaticResource PanelComboBox.Arrow.MouseOver.Color}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelComboBox.Button.Checked.Background}" />
              <Setter TargetName="arrow" Property="Shape.Fill" Value="{StaticResource PanelComboBox.Arrow.MouseOver.Color}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="arrow" Property="UIElement.Opacity" Value="0.3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="SplitActionComboBoxTemplate" TargetType="{x:Type local:SplitActionComboBox}">
    <Grid Background="{StaticResource Panel.Background}">
      <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <local:Panel Style="{StaticResource PanelStyle}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
          <ScrollViewer MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5" RenderOptions.ClearTypeHint="Enabled">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
          </ScrollViewer>
        </local:Panel>
      </Popup>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Name="PART_ActionButton" Grid.Column="0" ToolTip="{TemplateBinding local:SplitActionComboBox.ButtonToolTip}" ToolTipService.ShowOnDisabled="True" Command="{TemplateBinding local:SplitActionComboBox.ButtonCommand}" CommandParameter="{TemplateBinding local:SplitActionComboBox.ButtonCommandParameter}" Style="{StaticResource SplitActionComboBoxActionButtonStyle}" />
        <ToggleButton Grid.Column="1" ToolTip="{TemplateBinding local:SplitActionComboBox.ArrowToolTip}" ToolTipService.ShowOnDisabled="True" IsEnabled="{TemplateBinding ItemsControl.HasItems}" Style="{StaticResource SplitActionComboBoxArrowToggleButtonStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="SplitActionComboBoxItemContainerStyle" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Grid>
            <Border Name="highlight" Background="{StaticResource Panel.Background}" />
            <ContentPresenter />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SplitActionComboBoxStyle" TargetType="{x:Type local:SplitActionComboBox}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="Both" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="Template" Value="{StaticResource SplitActionComboBoxTemplate}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SplitActionComboBoxItemContainerStyle}" />
  </Style>
</ResourceDictionary>