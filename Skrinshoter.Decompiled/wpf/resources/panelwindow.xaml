<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="FramelessWindow.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="PanelWindowStyle" TargetType="{x:Type local:PanelWindow}" BasedOn="{StaticResource FramelessWindowStyle}">
    <Setter Property="Window.ShowActivated" Value="False" />
  </Style>
</ResourceDictionary>