<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:SkrinshoterApp">
  <system:Double x:Key="PanelSize">40</system:Double>
  <system:Double x:Key="VideoPanelSize">48</system:Double>
  <SolidColorBrush x:Key="Panel.Background" Color="White" />
  <SolidColorBrush x:Key="PanelButton.Normal.Color" Color="#ff333333" />
  <SolidColorBrush x:Key="PanelButton.Checked.Color" Color="#ff02a7eb" />
  <SolidColorBrush x:Key="PanelButton.Checked.Background" Color="#19333333" />
  <SolidColorBrush x:Key="PanelButton.Disabled.Color" Color="#FFC2C2C2" />
  <SolidColorBrush x:Key="PanelButton.Emphasized.Background" Color="#0d333333" />
  <SolidColorBrush x:Key="PanelButton.MouseOver.Background" Color="#19333333" />
  <SolidColorBrush x:Key="PanelButton.Pressed.Background" Color="#26333333" />
  <SolidColorBrush x:Key="PanelComboBox.Button.Checked.Background" Color="#4d333333" />
  <SolidColorBrush x:Key="PanelComboBox.Arrow.Normal.Color" Color="#33333333" />
  <SolidColorBrush x:Key="PanelComboBox.Arrow.MouseOver.Color" Color="#99333333" />
  <Style x:Key="PanelStyle" TargetType="{x:Type local:Panel}">
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Panel}">
          <Border Margin="3">
            <UIElement.Effect>
              <DropShadowEffect ShadowDepth="0" RenderingBias="Quality" Color="Gray" BlurRadius="3" />
            </UIElement.Effect>
            <Grid>
              <Border Name="MaskBorder" BorderThickness="0" CornerRadius="8" Background="{StaticResource Panel.Background}" />
              <Grid Name="ContentGrid">
                <ContentPresenter />
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>