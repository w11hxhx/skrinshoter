<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Panel.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="PanelToggleButtonStyle" TargetType="{x:Type ToggleButton}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Image}" TargetType="{x:Type Image}">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="24" />
          <Setter Property="Stretch" Value="None" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Width" Value="{StaticResource PanelSize}" />
    <Setter Property="Height" Value="{StaticResource PanelSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid>
            <Border Background="{StaticResource Panel.Background}">
              <Border Name="highlight" CornerRadius="4" Margin="4" />
            </Border>
            <Viewbox Stretch="Uniform" Margin="6">
              <ContentPresenter ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}">
                <ContentPresenter.Content>
                  <c:Binding RelativeSource="{RelativeSource TemplatedParent}">
                    <c:Binding.Path>IsChecked and Tag != null ? Tag : Content</c:Binding.Path>
                  </c:Binding>
                </ContentPresenter.Content>
              </ContentPresenter>
            </Viewbox>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Checked.Background}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>