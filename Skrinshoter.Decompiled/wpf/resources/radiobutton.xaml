<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="RadioButton.Unchecked.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RadioButton.Unchecked.Border" Color="#FFCFD4D9" />
  <SolidColorBrush x:Key="RadioButton.Checked.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RadioButton.Checked.Border" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="RadioButton.Checked.Glyph" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="RadioButton.MouseOver.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RadioButton.MouseOver.Border" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="RadioButton.Disabled.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RadioButton.Disabled.Border" Color="#FFEEEEEF" />
  <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="#FFEEEEEF" />
  <SolidColorBrush x:Key="RadioButton.Disabled.Text" Color="#66000000" />
  <Style x:Key="RadioButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Name="radioButtonBorder" Width="18" Height="18" BorderThickness="1" CornerRadius="100" VerticalAlignment="Center" Background="{StaticResource RadioButton.Unchecked.Background}" BorderBrush="{StaticResource RadioButton.Unchecked.Border}">
              <Ellipse Name="optionMark" Width="10" Height="10" Opacity="0" />
            </Border>
            <ContentPresenter Name="contentPresenter" Grid.Column="1" Focusable="False" VerticalAlignment="Center" Margin="15,-1,0,1" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="radioButtonBorder" Property="Border.Background" Value="{StaticResource RadioButton.MouseOver.Background}" />
              <Setter TargetName="radioButtonBorder" Property="Border.BorderBrush" Value="{StaticResource RadioButton.MouseOver.Border}" />
              <Setter TargetName="optionMark" Property="Shape.Fill" Value="{StaticResource RadioButton.MouseOver.Glyph}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="true">
              <Setter TargetName="radioButtonBorder" Property="Border.Background" Value="{StaticResource RadioButton.Checked.Background}" />
              <Setter TargetName="radioButtonBorder" Property="Border.BorderBrush" Value="{StaticResource RadioButton.Checked.Border}" />
              <Setter TargetName="optionMark" Property="Shape.Fill" Value="{StaticResource RadioButton.Checked.Glyph}" />
              <Setter TargetName="optionMark" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter TargetName="radioButtonBorder" Property="Border.Background" Value="{StaticResource RadioButton.Disabled.Background}" />
              <Setter TargetName="radioButtonBorder" Property="Border.BorderBrush" Value="{StaticResource RadioButton.Disabled.Border}" />
              <Setter TargetName="optionMark" Property="Shape.Fill" Value="{StaticResource RadioButton.Disabled.Glyph}" />
              <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{StaticResource RadioButton.Disabled.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButtonStyle}" />
</ResourceDictionary>