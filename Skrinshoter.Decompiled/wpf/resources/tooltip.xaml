<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <Style x:Key="ToolTipStyle" TargetType="{x:Type ToolTip}">
    <Setter Property="ToolTipService.Placement" Value="Top" />
    <Setter Property="ToolTipService.HorizontalOffset" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Margin="3">
            <UIElement.Effect>
              <DropShadowEffect ShadowDepth="0" RenderingBias="Quality" Color="Gray" BlurRadius="3" />
            </UIElement.Effect>
            <Grid>
              <Border BorderThickness="0" CornerRadius="6" Background="#FFFFFF" />
              <ContentPresenter Margin="8 3 8 4" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}" BasedOn="{StaticResource ToolTipStyle}" />
</ResourceDictionary>