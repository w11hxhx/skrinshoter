<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Default.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="GroupBoxStyle" TargetType="{x:Type GroupBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <Grid SnapsToDevicePixels="true" Margin="48,24,48,22">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter ContentSource="Header" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <DataTemplate x:Key="{DataTemplateKey {x:Type system:String}}" DataType="{x:Type system:String}">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,22" FontFamily="{StaticResource App.FontFamily.Header}" FontSize="{StaticResource App.FontSize.Header}" Text="{Binding}" />
                  </DataTemplate>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ContentPresenter>
            <ContentPresenter Grid.Row="1" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource GroupBoxStyle}" />
</ResourceDictionary>