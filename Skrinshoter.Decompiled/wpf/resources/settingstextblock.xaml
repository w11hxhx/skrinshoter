<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SettingsTextBlock.Static.Foreground" Color="#FF000000" />
  <SolidColorBrush x:Key="SettingsTextBlock.Disabled.Foreground" Color="#66000000" />
  <Style x:Key="SettingsTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize}" />
    <Setter Property="Foreground" Value="{StaticResource SettingsTextBlock.Static.Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-1,0,1" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBlock.Disabled.Foreground}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>