<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding">
  <SolidColorBrush x:Key="CloudStorageProgressBar.Track.Color" Color="#DBDBDB" />
  <LinearGradientBrush x:Key="CloudStorageProgressBar.Indicator.Default.Color" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#FF41C7F3" Offset="0" />
    <GradientStop Color="#FF468EDE" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CloudStorageProgressBar.Indicator.Warning.Color" Color="#CD4A4A" />
  <Style x:Key="CloudStorageProgressBarStyle" TargetType="{x:Type ProgressBar}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{StaticResource CloudStorageProgressBar.Track.Color}" />
    <Setter Property="Foreground" Value="{StaticResource CloudStorageProgressBar.Indicator.Default.Color}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid SnapsToDevicePixels="True">
            <Border CornerRadius="3" Background="{TemplateBinding Control.Background}" />
            <Grid Name="PART_Track" SnapsToDevicePixels="True">
              <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" MinWidth="6" Background="{TemplateBinding Control.Foreground}" SnapsToDevicePixels="True" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="RangeBase.Value" Value="0">
              <Setter TargetName="PART_Indicator" Property="UIElement.Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <c:Binding RelativeSource="{RelativeSource Self}">
            <c:Binding.Path>Value &gt;= Maximum * 0.8</c:Binding.Path>
          </c:Binding>
        </DataTrigger.Binding>
        <Setter Property="Foreground" Value="{StaticResource CloudStorageProgressBar.Indicator.Warning.Color}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>