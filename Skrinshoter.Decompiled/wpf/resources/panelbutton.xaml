<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Panel.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Image}" TargetType="{x:Type Image}">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="24" />
          <Setter Property="Stretch" Value="None" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Width" Value="{StaticResource PanelSize}" />
    <Setter Property="Height" Value="{StaticResource PanelSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Background="{StaticResource Panel.Background}">
              <Border Name="highlight" CornerRadius="4" Margin="4" />
            </Border>
            <Viewbox Stretch="Uniform" Margin="6">
              <ContentPresenter />
            </Viewbox>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PanelButtonExStyle" TargetType="{x:Type Button}">
    <Setter Property="MinWidth" Value="{StaticResource PanelSize}" />
    <Setter Property="Height" Value="{StaticResource PanelSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize.PanelButton}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PanelButton.Normal.Color}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Background="{StaticResource Panel.Background}">
              <Border Name="highlight" CornerRadius="4" Margin="4" />
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Stretch="Uniform" Margin="6">
                <Image Width="24" Height="24" Stretch="None" Source="{Binding Path=(local:IconProperties.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
              </Viewbox>
              <ContentPresenter Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.MouseOver.Background}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource PanelButton.Pressed.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>