<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ToggleSwitch.Static.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitch.Static.Border" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="ToggleSwitch.Static.Thumb" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="ToggleSwitch.MouseOver.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitch.MouseOver.Border" Color="#FF1A98D2" />
  <SolidColorBrush x:Key="ToggleSwitch.MouseOver.Thumb" Color="#FF1A98D2" />
  <SolidColorBrush x:Key="ToggleSwitch.Pressed.Background" Color="#FFF2F2F2" />
  <SolidColorBrush x:Key="ToggleSwitch.Pressed.Border" Color="#FF1A98D2" />
  <SolidColorBrush x:Key="ToggleSwitch.Pressed.Thumb" Color="#FF1A98D2" />
  <SolidColorBrush x:Key="ToggleSwitch.Disabled.Background" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitch.Disabled.Border" Color="#FFEEEEEF" />
  <SolidColorBrush x:Key="ToggleSwitch.Disabled.Thumb" Color="#FFEEEEEF" />
  <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="40" Height="20" UseLayoutRounding="True">
            <Border Name="border" CornerRadius="10" BorderThickness="1" UseLayoutRounding="False" BorderBrush="{StaticResource ToggleSwitch.Static.Border}" Background="{StaticResource ToggleSwitch.Static.Background}">
              <Ellipse Name="thumb" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource ToggleSwitch.Static.Thumb}">
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="thumbTransform" X="0" />
                </UIElement.RenderTransform>
              </Ellipse>
            </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup>
                <VisualState x:Name="Unchecked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="thumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="thumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0" />
                  </Storyboard>
                </VisualState>
                <VisualStateGroup.Transitions>
                  <VisualTransition From="Unchecked" To="Checked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualTransition>
                  <VisualTransition From="Checked" To="Unchecked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource ToggleSwitch.MouseOver.Background}" />
              <Setter TargetName="border" Property="Border.BorderBrush" Value="{StaticResource ToggleSwitch.MouseOver.Border}" />
              <Setter TargetName="thumb" Property="Shape.Fill" Value="{StaticResource ToggleSwitch.MouseOver.Thumb}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource ToggleSwitch.Pressed.Background}" />
              <Setter TargetName="border" Property="Border.BorderBrush" Value="{StaticResource ToggleSwitch.Pressed.Border}" />
              <Setter TargetName="thumb" Property="Shape.Fill" Value="{StaticResource ToggleSwitch.Pressed.Thumb}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Border.Background" Value="{StaticResource ToggleSwitch.Disabled.Background}" />
              <Setter TargetName="border" Property="Border.BorderBrush" Value="{StaticResource ToggleSwitch.Disabled.Border}" />
              <Setter TargetName="thumb" Property="Shape.Fill" Value="{StaticResource ToggleSwitch.Disabled.Thumb}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>