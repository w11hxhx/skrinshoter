  <Style x:Key="IconPathStyle" TargetType="{x:Type Path}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Shape.Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{Binding (local:IconBrush.Value), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Stroke" Value="{Binding (local:IconBrush.Value), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Width" Value="{Binding (local:IconBox.Width), RelativeSource={RelativeSource Self}, Converter={StaticResource NullToUnsetValueConverter}}" />
    <Setter Property="StrokeThickness" Value="{Binding Data.(local:IconMeta.StrokeThickness), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Shape.StrokeStartLineCap" Value="{Binding Data.(local:IconMeta.LineCap), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Shape.StrokeEndLineCap" Value="{Binding Data.(local:IconMeta.LineCap), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Shape.StrokeLineJoin" Value="{Binding Data.(local:IconMeta.LineJoin), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Shape.StrokeMiterLimit" Value="{Binding Data.(local:IconMeta.MiterLimit), RelativeSource={RelativeSource Self}}" />
    <Style.Triggers>
      <DataTrigger Value="{x:Static local:IconRenderMode.Fill}" Binding="{Binding Data.(local:IconMeta.RenderMode), RelativeSource={RelativeSource Self}}">
        <Setter Property="StrokeThickness" Value="0" />
      </DataTrigger>
      <DataTrigger Value="{x:Static local:IconRenderMode.Stroke}" Binding="{Binding Data.(local:IconMeta.RenderMode), RelativeSource={RelativeSource Self}}">
        <Setter Property="Fill" Value="#00FFFFFF" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
