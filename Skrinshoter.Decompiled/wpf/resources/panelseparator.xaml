<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Panel.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DrawingImage x:Key="VerticalPanelSeparatorImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry>
          <RectangleGeometry Rect="0.0,0.0,9.0,40.0" />
        </DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="#ffffffff">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0.0,0.0,9.0,40.0" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <DrawingGroup Transform="6.12303e-17,1.0,-1.0,6.12303e-17,13.0,3.0">
          <GeometryDrawing Brush="#3f000000">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="5.0,8.0,24.0,1.0" RadiusX="0.5" RadiusY="0.5" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <Style x:Key="VerticalPanelSeparatorStyle" TargetType="{x:Type Separator}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Viewbox Stretch="Uniform" Height="{StaticResource PanelSize}">
            <Image Width="9" Height="40" Stretch="None" Source="{StaticResource VerticalPanelSeparatorImage}" />
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DrawingImage x:Key="HorizontalPanelSeparatorImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <DrawingGroup.ClipGeometry>
          <RectangleGeometry Rect="0.0,0.0,40.0,9.0" />
        </DrawingGroup.ClipGeometry>
        <GeometryDrawing Brush="#ffffffff">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0.0,0.0,40.0,9.0" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#3f000000">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="8.0,4.0,24.0,1.0" RadiusX="0.5" RadiusY="0.5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <Style x:Key="HorizontalPanelSeparatorStyle" TargetType="{x:Type Separator}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Viewbox Stretch="Uniform" Width="{StaticResource PanelSize}">
            <Image Width="40" Height="9" Stretch="None" Source="{StaticResource HorizontalPanelSeparatorImage}" />
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>