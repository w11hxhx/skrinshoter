<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp">
  <SolidColorBrush x:Key="SettingsTabItem.Icon.Static.Color" Color="#FF17334A" />
  <SolidColorBrush x:Key="SettingsTabItem.Icon.Selected.Color" Color="#FF1DA8E9" />
  <SolidColorBrush x:Key="SettingsTabItem.Selected.Background" Color="#FFF6FCFE" />
  <SolidColorBrush x:Key="SettingsTabItem.Text.Color" Color="#FF000000" />
  <DataTemplate x:Key="SettingsTabItemHeaderTemplate">
    <Grid Background="#00FFFFFF" Cursor="Hand">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="25" />
        <ColumnDefinition Width="15" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path Name="Icon" Grid.Column="1" Style="{StaticResource IconPathStyle}" Data="{Binding Path=Tag.IconGeometry, RelativeSource={RelativeSource AncestorType=TabItem}}" local:IconBrush.Value="{Binding Path=Tag.IconBrush, RelativeSource={RelativeSource AncestorType=TabItem}}" local:IconBox.Width="{Binding Path=Tag.IconWidth, RelativeSource={RelativeSource AncestorType=TabItem}}">
        <UIElement.RenderTransform>
          <TranslateTransform X="{Binding Path=Tag.IconShiftX, RelativeSource={RelativeSource AncestorType=TabItem}}" />
        </UIElement.RenderTransform>
      </Path>
      <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,-1,0,1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding}" Foreground="{Binding Path=Tag.TextBrush, RelativeSource={RelativeSource AncestorType=TabItem}}" FontWeight="{Binding Path=Tag.TextFontWeight, RelativeSource={RelativeSource AncestorType=TabItem}}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="True" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}">
        <Setter TargetName="Icon" Property="local:IconBrush.Value" Value="{StaticResource SettingsTabItem.Icon.Selected.Color}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="SettingsTabItemStyle" TargetType="{x:Type TabItem}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Width" Value="290" />
    <Setter Property="Height" Value="50" />
    <Setter Property="HeaderTemplate" Value="{StaticResource SettingsTabItemHeaderTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border Name="highlight" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="highlight" Property="Border.Background" Value="{StaticResource SettingsTabItem.Selected.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsTabControlStyle" TargetType="{x:Type TabControl}">
    <Setter Property="TabControl.TabStripPlacement" Value="Left" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItemStyle}" />
    <Setter Property="FontFamily" Value="{StaticResource App.FontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource App.FontSize}" />
    <Setter Property="Padding" Value="0,0,0,24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#00FFFFFF">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TabPanel Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="#00FFFFFF" Margin="0,20,0,0" />
                <ContentPresenter Grid.Row="2" ContentTemplate="{TemplateBinding FrameworkElement.Tag}" Content="{Binding}" />
              </Grid>
            </Border>
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#0D000000" Margin="0,40" />
            <Border Grid.Column="2" Background="{TemplateBinding Control.Background}">
              <ScrollViewer Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" FocusVisualStyle="{x:Null}">
                <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Control.Padding}" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
