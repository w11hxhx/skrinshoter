      <SolidColorBrush x:Key="ClearButton.Static.Background" Color="#66000000" />
      <SolidColorBrush x:Key="ClearButton.MouseOver.Background" Color="#CC000000" />
      <SolidColorBrush x:Key="ClearButton.Disabled.Background" Color="#26000000" />
      <SolidColorBrush x:Key="Watermark.Foreground" Color="#66000000" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <TextBox Name="PART_TextBox" Style="{StaticResource TextBoxStyle}" Padding="17,4,34,6" IsTabStop="False" InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}" Text="{Binding DisplayText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" local:MouseOverProxy.ExternalMouseOver="{Binding ElementName=PART_Clear, Path=IsMouseOver}" PreviewGotKeyboardFocus="OnPreviewGotKeyboardFocus" GotKeyboardFocus="OnGotKeyboardFocus" LostKeyboardFocus="OnLostKeyboardFocus" PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput" />
    <TextBlock IsHitTestVisible="False" Margin="21,4,35,6" Foreground="{StaticResource Watermark.Foreground}" Text="{Binding Path=(props:Resources.HotkeyBox_HotkeyNotSet)}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource SettingsTextBlockStyle}" TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="" Binding="{Binding Text, ElementName=PART_TextBox}" />
                <Condition Value="False" Binding="{Binding IsKeyboardFocused, ElementName=PART_TextBox}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <TextBlock IsHitTestVisible="False" Margin="21,4,35,6" Foreground="{StaticResource Watermark.Foreground}" Text="{Binding Path=(props:Resources.HotkeyBox_InputHotkey)}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource SettingsTextBlockStyle}" TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="" Binding="{Binding Text, ElementName=PART_TextBox}" />
                <Condition Value="True" Binding="{Binding IsKeyboardFocused, ElementName=PART_TextBox}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Button Name="PART_Clear" Width="29" Height="29" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" Margin="3,0" Padding="0" Focusable="False" Cursor="Hand" Click="OnClearClick">
      <Control.Template>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border CornerRadius="8" Background="#00FFFFFF">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Control.Template>
      <Path Data="{StaticResource ClearButton.Geometry}" Width="16" Height="16">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Path}">
            <Setter Property="Fill" Value="{StaticResource ClearButton.Static.Background}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}">
                <Setter Property="Fill" Value="{StaticResource ClearButton.MouseOver.Background}" />
              </DataTrigger>
              <DataTrigger Value="False" Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}">
                <Setter Property="Fill" Value="{StaticResource ClearButton.Disabled.Background}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Path>
    </Button>
  </Grid>
</UserControl>