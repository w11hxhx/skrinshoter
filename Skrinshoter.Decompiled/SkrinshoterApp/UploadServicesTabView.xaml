<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SkrinshoterApp.UploadServicesTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp" UseLayoutRounding="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SettingsTextBlockStyle}" />
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <GroupBox Header="Встроенные сервисы">
      <StackPanel>
        <UniformGrid Columns="2">
          <CheckBox Content="Скриншотер" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.Skrinshoter}}}" />
          <CheckBox Content="kappa.lol" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.KappaLol}}}" />
          <CheckBox Margin="0,10,0,0" Content="Xyli" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.Xyli}}}" />
          <CheckBox Margin="0,10,0,0" Content="0xl1r.cfd" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.ZeroXl1r}}}" />
          <CheckBox Margin="0,10,0,0" Content="NoikCloud" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.NoikCloud}}}" />
          <CheckBox Margin="0,10,0,0" Content="i.nuuls.com" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.Nuuls}}}" />
        </UniformGrid>
        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Выбрать все сервисы" Command="{Binding SelectAllScreenshotUploadServicesCommand}" />
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Свои сервисы" Margin="0,16,0,0">
      <StackPanel>
        <CheckBox Content="Использовать включённые свои сервисы" IsChecked="{Binding Settings.ScreenshotUploadDestinations, Converter={local:EnumFlagToBooleanConverter Flag={x:Static local:ScreenshotUploadDestination.Custom}}}" />
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Settings.CustomUploadProviders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,4" Padding="10" CornerRadius="6" Background="#0D000000">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Удалить" Click="RemoveService_Click" />
                  <Button DockPanel.Dock="Right" Content="Настроить" Click="EditService_Click" Margin="8,0" />
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Margin="0,12,0,0">
          <Button Content="+ Добавить вручную" Click="AddService_Click" />
          <Button Margin="10,0,0,0" Content="Импортировать ShareX (.sxcu)" Click="ImportShareX_Click" />
        </WrapPanel>
      </StackPanel>
    </GroupBox>
    <GroupBox Header="После загрузки" Margin="0,16,0,0">
      <StackPanel>
        <CheckBox Content="Оставлять названия сервисов в ссылках" IsChecked="{Binding Settings.IncludeServiceNames}" />
        <CheckBox Margin="0,10,0,0" Content="Копировать ссылки в буфер обмена" IsChecked="{Binding Settings.CopyScreenshotLinksToClipboard}" />
        <CheckBox Margin="0,10,0,0" Content="Открывать ссылки в браузере" IsChecked="{Binding Settings.OpenScreenshotInBrowser}" />
        <TextBlock Margin="0,12,0,0" Foreground="#8A000000">
          <Run Text="Быстрая загрузка во все выбранные сервисы: " />
          <Run Text="{Binding Settings.UploadScreenshotToAllHotkey}" FontWeight="SemiBold" />
        </TextBlock>
      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
