<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SkrinshoterApp.VideoTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding" xmlns:props="clr-namespace:SkrinshoterApp.Properties" xmlns:local="clr-namespace:SkrinshoterApp" xmlns:CameraCapture="clr-namespace:CameraCapture;assembly=CameraCapture" UseLayoutRounding="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SettingsTextBlockStyle}" />
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}" />
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}" />
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SettingsComboBoxStyle}" />
      <DataTemplate x:Key="CameraDeviceComboBoxItemTemplate" DataType="{x:Type CameraCapture:CameraDeviceDescription}">
        <TextBlock Text="{Binding Name}" />
      </DataTemplate>
      <DataTemplate x:Key="AudioDeviceComboBoxSelectedItemTemplate" DataType="{x:Type local:AudioDeviceInfo}">
        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
      </DataTemplate>
      <DataTemplate x:Key="AudioDeviceComboBoxDropDownItemTemplate" DataType="{x:Type local:AudioDeviceInfo}">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="{Binding Name}" />
          <TextBlock Name="realDeviceName" Foreground="#FF444646" FontSize="15" Text="{Binding RealDeviceName}" />
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding RealDeviceName}" Value="{x:Null}">
            <Setter TargetName="realDeviceName" Property="UIElement.Visibility" Value="Collapsed" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel Orientation="Vertical">
      <GroupBox Header="{Binding Path=(props:Resources.Settings_Video_GroupHeader_WhereToSave)}">
        <StackPanel Orientation="Vertical">
          <RadioButton Name="SaveToCloud" IsChecked="{Binding Settings.VideoSaveType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:VideoSaveType.Cloud}}">
            <TextBlock Margin="0">
              <Run Text="{Binding Path=(props:Resources.Settings_Video_SaveType_Cloud), Mode=OneWay}" /> <Run Foreground="#7A7D80" Text="{Binding Path=(props:Resources.Settings_Video_MaxDuration_Cloud_Free), Mode=OneWay}" /></TextBlock>
          </RadioButton>
          <CheckBox Margin="33,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_OpenInBrowser)}" IsChecked="{Binding Settings.OpenVideoInBrowser}" IsEnabled="{Binding IsChecked, ElementName=SaveToCloud}" />
        </StackPanel>
      </GroupBox>
      <GroupBox Header="{Binding Path=(props:Resources.Settings_Video_GroupHeader_Sources)}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding Path=(props:Resources.Settings_Video_Source_Camera)}" />
          <ComboBox Grid.Row="0" Grid.Column="2" SelectedValuePath="Id" ItemTemplate="{StaticResource CameraDeviceComboBoxItemTemplate}" local:ComboBoxHelper.PlaceholderText="{Binding Path=(props:Resources.Settings_Video_Source_CameraNotConnected)}" ItemsSource="{Binding SelectCameraDevicesVM.CameraDevices}" SelectedValue="{Binding SelectCameraDevicesVM.SelectedCameraDevice}" />
          <TextBlock Grid.Row="2" Text="{Binding Path=(props:Resources.Settings_Video_Source_Microphone)}" />
          <ComboBox Grid.Row="2" Grid.Column="2" SelectedValuePath="Id" local:ComboBoxHelper.PlaceholderText="{Binding Path=(props:Resources.Settings_Video_Source_MicrophoneNotConnected)}" ItemsSource="{Binding SelectAudioDevicesVM.InputAudioDevices}" SelectedValue="{Binding SelectAudioDevicesVM.SelectedInputAudioDevice}" ItemTemplateSelector="{local:ComboBoxTemplateSelector SelectedItemTemplate={StaticResource AudioDeviceComboBoxSelectedItemTemplate}, DropDownItemTemplate={StaticResource AudioDeviceComboBoxDropDownItemTemplate}}" />
          <TextBlock Grid.Row="4" Text="{Binding Path=(props:Resources.Settings_Video_Source_SystemSound)}" />
          <ComboBox Grid.Row="4" Grid.Column="2" SelectedValuePath="Id" local:ComboBoxHelper.PlaceholderText="{Binding Path=(props:Resources.Settings_Video_Source_SystemSoundNoSource)}" ItemsSource="{Binding SelectAudioDevicesVM.OutputAudioDevices}" SelectedValue="{Binding SelectAudioDevicesVM.SelectedOutputAudioDevice}" ItemTemplateSelector="{local:ComboBoxTemplateSelector SelectedItemTemplate={StaticResource AudioDeviceComboBoxSelectedItemTemplate}, DropDownItemTemplate={StaticResource AudioDeviceComboBoxDropDownItemTemplate}}" />
        </Grid>
      </GroupBox>
      <GroupBox Header="{Binding Path=(props:Resources.Settings_Video_GroupHeader_Quality)}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Path=(props:Resources.Settings_Video_Quality)}" />
          <ComboBox Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding VideoQualityLevels}" SelectedValue="{Binding Settings.VideoQualityLevel}" />
        </Grid>
      </GroupBox>
      <GroupBox Header="{Binding Path=(props:Resources.Settings_Video_GroupHeader_Misc)}">
        <StackPanel Orientation="Vertical">
          <CheckBox Content="{Binding Path=(props:Resources.Settings_Video_StartRecordingImmediatelyAfterSelection)}" IsChecked="{Binding Settings.StartRecordingVideoImmediatelyAfterSelection}" />
          <CheckBox Margin="0,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_ShowControlPanel)}" IsChecked="{Binding Settings.ShowVideoControlPanel}" />
          <CheckBox Margin="0,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_ShowMutedMicrophoneWarning)}" IsChecked="{Binding Settings.ShowMutedMicrophoneWarning}">
            <UIElement.Visibility>
              <c:Binding>
                <c:Binding.Path>IsMutedMicrophoneWarningSupported</c:Binding.Path>
              </c:Binding>
            </UIElement.Visibility>
          </CheckBox>
          <CheckBox Margin="0,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_ShowCursor)}" IsChecked="{Binding Settings.DrawCursorOnVideo}" />
          <CheckBox Margin="0,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_HighlightMousePointer)}" IsChecked="{Binding Settings.HighlightMousePointer}" />
          <CheckBox Margin="0,12,0,0" Content="{Binding Path=(props:Resources.Settings_Video_HighlightMouseClicks)}" IsChecked="{Binding Settings.HighlightMouseClicks}" />
        </StackPanel>
      </GroupBox>
    </StackPanel>
  </Grid>
</UserControl>
