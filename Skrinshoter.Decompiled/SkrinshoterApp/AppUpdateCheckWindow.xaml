<Window x:Class="SkrinshoterApp.AppUpdateCheckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Обновление форка Скриншотера" Width="700" Height="570" MinHeight="430" MinWidth="600" WindowStartupLocation="CenterScreen" Background="#F4F4F4" FontFamily="Segoe UI" Closed="Window_Closed">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Обновления w11hxhx/skrinshoter"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
      <TextBlock><Run Text="Установлена: "/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/><Run Text="    Последний релиз: "/><Run Text="{Binding LatestVersion, Mode=OneWay}"/></TextBlock>
      <TextBlock Text="Что добавили и исправили" FontWeight="SemiBold" Margin="0,12,0,0"/>
    </StackPanel>
    <TextBox Grid.Row="2" Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" Background="White"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      <ProgressBar Height="8" Margin="0,8,0,0" Value="{Binding Progress}" Maximum="100">
        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
      </ProgressBar>
    </StackPanel>
    <CheckBox Grid.Row="4" Content="Предлагать обновления форка автоматически" IsChecked="{Binding CheckForUpdates}" Margin="0,14,0,12"/>
    <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
      <Button Content="Пропустить версию" Command="{Binding SkipVersionCommand}" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="Позже / закрыть" Click="Later_Click" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="Отменить загрузку" Command="{Binding CancelDownloadCommand}" Padding="10,7" Margin="0,0,8,0" IsEnabled="{Binding Busy}"/>
      <Button Content="Скачать и установить" Command="{Binding DownloadNewVersionCommand}" Padding="10,7" FontWeight="SemiBold"/>
    </WrapPanel>
  </Grid>
</Window>
