<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SkrinshoterApp.ProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SkrinshoterApp" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Closing="Window_Closing">
  <local:Panel Style="{StaticResource PanelStyle}">
    <StackPanel Orientation="Vertical" Margin="12,4,12,10">
      <TextBlock FontFamily="Calibri" FontSize="16" Text="{Binding Message}" />
      <Grid Margin="0,3,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar MinWidth="272" Height="24" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" />
        <Button Grid.Column="1" Style="{StaticResource Button}" Width="80" Height="28" FontFamily="Calibri" FontSize="16" Margin="7,0,0,0" Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" />
      </Grid>
    </StackPanel>
  </local:Panel>
</Window>