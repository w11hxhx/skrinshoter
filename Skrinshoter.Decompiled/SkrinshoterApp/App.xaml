        <ResourceDictionary Source="Wpf\Resources\CameraWindowTv.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ContextMenu.xaml" />
        <ResourceDictionary Source="Wpf\Resources\Images.xaml" />
        <ResourceDictionary Source="Wpf\Resources\Slider.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ProgressBar.xaml" />
        <ResourceDictionary Source="Wpf\Resources\CloudStorageProgressBar.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ToolTip.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ToolTipIcon.xaml" />
        <ResourceDictionary Source="Wpf\Resources\MessageWindowCloseButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\DialogWindowCloseButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\SettingsTabControl.xaml" />
        <ResourceDictionary Source="Wpf\Resources\GroupBox.xaml" />
        <ResourceDictionary Source="Wpf\Resources\CheckBox.xaml" />
        <ResourceDictionary Source="Wpf\Resources\RadioButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\TextBox.xaml" />
        <ResourceDictionary Source="Wpf\Resources\SettingsButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\SettingsBlueButton.xaml" />
