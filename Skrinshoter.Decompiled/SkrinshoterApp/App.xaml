<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="SkrinshoterApp.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SkrinshoterApp" ShutdownMode="OnExplicitShutdown" Startup="Application_Startup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Wpf\Resources\Default.xaml" />
        <ResourceDictionary Source="Wpf\Resources\FramelessWindow.xaml" />
        <ResourceDictionary Source="Wpf\Resources\PanelWindow.xaml" />
        <ResourceDictionary Source="Wpf\Resources\Panel.xaml" />
        <ResourceDictionary Source="Wpf\Resources\PanelButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\PanelToggleButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\PanelComboBox.xaml" />
        <ResourceDictionary Source="Wpf\Resources\PanelSeparator.xaml" />
