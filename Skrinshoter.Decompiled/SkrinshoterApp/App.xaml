        <ResourceDictionary Source="Wpf\Resources\VideoPanelButton.xaml" />
        <ResourceDictionary Source="Wpf\Resources\SplitActionComboBox.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ScreenshotEditingDrawingWindowImages.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ScreenshotEditingActionWindowImages.xaml" />
        <ResourceDictionary Source="Wpf\Resources\ScreenshotEditingVisualObjects.xaml" />
